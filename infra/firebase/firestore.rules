rules_version = '2';

// Sincronización de perfiles, favoritos y progreso entre dispositivos (ver
// docs/CLOUD-SYNC.md). Cada cuenta solo ve y escribe bajo su propio users/{uid}; el
// catálogo, las credenciales de proveedor y el streaming nunca pasan por aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
