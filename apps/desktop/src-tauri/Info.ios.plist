<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La interfaz habla con el núcleo por http://127.0.0.1 y los logos de canal llegan
	     por http desde el proveedor: sin esto, iOS los bloquea. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- El audio sigue con la pantalla bloqueada o en otra app (decidido con el usuario),
	     con sus controles en la pantalla de bloqueo. Además, mientras suena, iOS no
	     suspende la app y el servidor local sigue vivo. -->
	<!-- La copia de seguridad (Ajustes → Datos y copia) se guarda en Documentos: así se ve en
	     la app «Archivos», en «En mi iPhone → VIBE IPTV». -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- F17: iOS despierta la app de vez en cuando para mirar si hay episodios nuevos de
		     las series seguidas (ios/Sources/VibeBackground.swift). Solo si el perfil lo
		     activó en Ajustes; si no, la comprobación no hace nada. -->
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.vibeiptv.desktop.refresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
